NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hots_stats
PORT=3001
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001
# Set to the shared parent domain (e.g. .mondomaine.fr) when the web app and
# the API are on different subdomains, so the session cookie is visible to
# both. Leave unset for local dev (same host).
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Battle.net login only appears on the login page once BOTH of
# these are set -- leave empty to offer Google only. Redirect URL to
# register with the Battle.net client: ${API_PUBLIC_URL}/auth/battlenet/callback
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
SESSION_SECRET=
# Bearer token guarding /_internal/* routes (e.g. `openssl rand -hex 32`):
# quarantine inspection and daemon error triage (GET /_internal/errors).
CLAUDE_INTERNAL_SECRET=
