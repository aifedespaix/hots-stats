{
  "name": "@hots-stats/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "check-build": "bun run scripts/check-build.ts"
  },
  "dependencies": {
    "@hots-stats/db": "workspace:*",
    "@hots-stats/shared-types": "workspace:*",
    "arctic": "3.7.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "6.0.3"
  }
}
