# Root .env — used by docker-compose.dev.yml (local Postgres only) and as the
# reference list of every variable the stack needs. In production on Dokploy,
# these are set per-app (see DEPLOYMENT.md), not from this file.

# --- Postgres (local dev / backend compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hots_stats

# --- API (apps/api) ---
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hots_stats
PORT=3001
# Public URL of the web app, used for CORS.
WEB_ORIGIN=http://localhost:3000
# Publicly reachable URL of this API — used to build the Google OAuth
# redirect URI, must match what's registered in Google Cloud Console.
API_PUBLIC_URL=http://localhost:3001
# Shared parent domain for the session cookie (e.g. .mondomaine.fr), required
# whenever WEB_ORIGIN and API_PUBLIC_URL are on different subdomains — see
# DEPLOYMENT.md. Leave empty for local dev.
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Battle.net login (see community.developer.battle.net) only
# appears on the login page once BOTH of these are set -- leave empty to
# offer Google only. Redirect URL to register with the Battle.net client:
# ${API_PUBLIC_URL}/auth/battlenet/callback
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
# Random 32+ char secret used to sign session cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Random 32+ char bearer token guarding /_internal/* routes (e.g.
# `openssl rand -hex 32`), used to inspect quarantined replay samples and
# triage daemon-reported ingestion errors (GET /_internal/errors).
CLAUDE_INTERNAL_SECRET=

# --- Web (apps/web) ---
# Public URL of the API, baked in at build time and used client-side.
NUXT_PUBLIC_API_BASE=http://localhost:3001
